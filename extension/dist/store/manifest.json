{
  "manifest_version": 3,
  "name": "4 U By U — Lecture to Study Notes",
  "version": "2.2.1",
  "description": "Turn the YouTube lecture you are watching into topic-wise study notes. Your own API key, one HTML file. No account, no server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://anikethana21.github.io/4ubyu/",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.groq.com/*"
  ],
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
