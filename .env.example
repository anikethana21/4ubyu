# 4 U By U Environment Configuration

# Execution Mode: "private" (Local machine, unrestricted) | "public" (BYOK-enforced, hard-capped)
APP_MODE=private

# ---------------------------------------------------------------------------
# Cloud Database & Authentication (Supabase)
# Required for login/registration, the per-user encrypted settings vault, and
# saved workspaces. Without these, the app runs but auth/vault endpoints return
# 503 ("service is not configured").
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Session & Vault Cryptography
# ---------------------------------------------------------------------------
# JWT signing secret for login sessions. Set a long random value in production.
JWT_SECRET=
# Optional. Encrypts user API keys before they are stored in Supabase. If left
# blank it is derived deterministically from JWT_SECRET (so keep JWT_SECRET
# stable, or existing stored keys will no longer decrypt).
FERNET_KEY=

# ---------------------------------------------------------------------------
# LLM / BYOK keys — OPTIONAL
# These are normally NOT set here. Each user enters their own keys in the UI;
# they are Fernet-encrypted and stored in the Supabase `user_settings` vault,
# then decrypted only for that user's requests. Set them only if you want a
# shared default for local `private` mode.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
ERASER_API_KEY=

# Public Hard-Capped Guardrails
MAX_PUBLIC_STORAGE_MB=450
MAX_PUBLIC_HANDBOOKS=150
ENFORCE_PUBLIC_BYOK=true

# ---------------------------------------------------------------------------
# YouTube ingestion from a datacenter host (Render, Vercel, AWS, GCP ...)
# ---------------------------------------------------------------------------
# IMPORTANT: cloud hosts do NOT escape YouTube's bot check. Render's datacenter
# IPs are gated exactly like Vercel's ("Sign in to confirm you're not a bot"),
# which blocks BOTH metadata (duration/description) and transcripts. A local /
# residential IP is unaffected. To restore full ingestion on a cloud host, use
# one (or more) of the options below.

# Option A (free, metadata only): official YouTube Data API v3 key.
# Restores duration + description (and description chapters), but not text.
YOUTUBE_API_KEY=

# Option B (free, metadata + transcripts): cookies exported from a signed-in
# browser, given to yt-dlp. Base64-encode cookies.txt into this single-line var:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# Export with a "Get cookies.txt LOCALLY" style browser extension.
YT_COOKIES_B64=
# Or point straight at a cookies.txt file already present on the host:
YT_COOKIES=

# Option C (paid, most reliable): residential proxy for every YouTube request.
# Example: http://user:pass@proxy-host:port
YT_PROXY_URL=

# ---------------------------------------------------------------------------
# Client-side ingestion (browser userscript / extension) — RECOMMENDED
# ---------------------------------------------------------------------------
# None of the options above are needed when the transcript is captured in the
# user's own browser (extension/4ubyu.user.js): their residential IP is not
# bot-gated, and cookies never leave their machine.
#
# Shared secret the userscript presents as "Authorization: Bearer <value>".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Payloads pushed with this token are stored unowned and are readable ONLY while
# APP_MODE=private. Per-user ingest tokens (Settings → Connections) are the
# multi-user path.
EXTENSION_INGEST_TOKEN=

# Hard cap, in bytes, on a single ingest request body (default 8 MB).
MAX_INGEST_BYTES=8388608

# How long a captured transcript stays on the server before expiring (hours).
INGEST_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Provider quota: how many model calls a run is allowed to cost
# ---------------------------------------------------------------------------
# Free tiers meter tokens per MINUTE (Groq's free tier allows 8,000 for
# gpt-oss-120b), so the number of calls matters as much as their size. These
# defaults are the cheap path; each one can be turned back up.

# How a section's notes are written:
#   lean   — one call per section, asked for the explanation, analogy, key
#            points, pitfalls and example at once (default)
#   agents — the original five-agent fan-out: five calls per section, each with
#            a hardcoded fallback when it fails
PHASE5_MODE=lean

# Translate a non-Latin transcript into English before analysis. Off by default:
# translation costs one call every few thousand characters (dozens per lecture)
# and the note-writing models read the source language directly.
TRANSLATE_TRANSCRIPT=0

# How many sections are written concurrently. Higher is faster and spends the
# per-minute allowance in bigger bursts, which is what causes 429s on a free tier.
PHASE5_PARALLEL=6
